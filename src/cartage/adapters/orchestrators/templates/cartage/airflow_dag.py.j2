{% block header %}
# Generated by cartage {{ cartage_version }} from {{ pipeline_path }}. Do not edit by hand:
# change the pipeline YAML, .cartage/config.yaml or templates/airflow/dag.py.j2 (`cartage scaffold airflow`),
# then run `cartage generate --target airflow`.
# The cartage project (including transforms/) must be deployed with this DAG; see PROJECT_DIR.
{% endblock %}
{% block imports %}
import os
import shlex

import pendulum
from airflow.decorators import dag, task
{% if image %}
from kubernetes.client import models as k8s
{% endif %}
{% for function in [default_args_from, schedule_from] if function %}
from {{ function[0] }} import {{ function[1] }}
{% endfor %}
{% endblock %}

PROJECT_DIR = os.path.normpath(os.path.join(os.path.dirname(__file__), {{ project_dir | py }}))

{% block default_args %}
{% if default_args_from %}
default_args = {{ default_args_from[1] }}{{ default_args | kwargs }}
{% else %}
default_args = {{ default_args | pyw }}
{% endif %}
{% endblock %}


{% block dag %}
@dag(
    dag_id={{ dag_id | py }},
    schedule={% block schedule %}{% if schedule_from %}{{ schedule_from[1] }}({{ schedule | py }}){% else %}{{ schedule | py }}{% endif %}{% endblock %},
    start_date=pendulum.datetime(2024, 1, 1, tz="UTC"),
    catchup={{ catchup | py }},
    tags={{ tags | pyw(4) }},
    default_args=default_args,
)
def {{ dag_function }}():
{% block task %}
{% if not (task_env or image or operator_args) %}
    @task.{{ task_decorator }}
{% else %}
    @task.{{ task_decorator }}(
{% if task_env %}
        env={{ task_env | pyw(8) }},
        append_env=True,
{% endif %}
{% if image %}
        executor_config={
            "pod_override": k8s.V1Pod(
                spec=k8s.V1PodSpec(containers=[k8s.V1Container(name="base", image={{ image | py }})])
            )
        },
{% endif %}
{% for key, value in operator_args | dictsort %}
        {{ key }}={{ value | pyw(8) }},
{% endfor %}
    )
{% endif %}
    def cartage_run():
        command = [
            {{ command | py }},
            "--project-dir", shlex.quote(PROJECT_DIR),
            "run", {{ run_target | py }},
            "--env", {{ env_expr | py }},
        ]
        return " ".join(command)

    cartage_run()
{% endblock %}


{{ dag_function }}()
{% endblock %}
{% block extra %}
{% endblock %}
