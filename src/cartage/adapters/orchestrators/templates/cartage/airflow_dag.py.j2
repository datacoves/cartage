{% block header %}
# Generated by cartage {{ cartage_version }} from {{ pipeline_path }}. Do not edit by hand:
# change the pipeline YAML, cartage.yaml or templates/airflow/dag.py.j2, then run `cartage generate --target airflow`.
# The cartage project (including transforms/) must be deployed with this DAG; see PROJECT_DIR.
{% endblock %}
{% block imports %}
import os
import shlex

import pendulum
from airflow import DAG
from {{ operator_module }} import {{ operator_class }}
{% if image %}
from kubernetes.client import models as k8s
{% endif %}
{% endblock %}

PROJECT_DIR = os.path.normpath(os.path.join(os.path.dirname(__file__), {{ project_dir | py }}))

{% block default_args %}
default_args = {{ default_args | py }}
{% endblock %}

{% block dag %}
with DAG(
    dag_id={{ dag_id | py }},
    schedule={{ schedule | py }},
    start_date=pendulum.datetime(2024, 1, 1, tz="UTC"),
    catchup={{ catchup | py }},
    tags={{ tags | py }},
    default_args=default_args,
) as dag:
{% block task %}
    {{ operator_class }}(
        task_id="cartage_run",
        bash_command={{ command | py }} + " --project-dir " + shlex.quote(PROJECT_DIR) + " run " + {{ run_args | py }},
{% if task_env %}
        env={{ task_env | py }},
        append_env=True,
{% endif %}
{% if image %}
        executor_config={"pod_override": k8s.V1Pod(spec=k8s.V1PodSpec(containers=[k8s.V1Container(name="base", image={{ image | py }})]))},
{% endif %}
{% for key, value in operator_args | dictsort %}
        {{ key }}={{ value | py }},
{% endfor %}
    )
{% endblock %}
{% endblock %}
{% block extra %}
{% endblock %}
