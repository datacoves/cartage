{% block header %}
# Generated by cartage {{ cartage_version }} from {{ pipeline_path }}. Do not edit by hand:
# change the pipeline YAML, .cartage/config.yaml or templates/prefect/prefect.py.j2 (`cartage scaffold prefect`),
# then run `cartage generate --target prefect`.
# The cartage project (including transforms/) must be deployed with this file; see PROJECT_DIR.
{% endblock %}
{% block imports %}
import os
import shlex
import subprocess

from prefect import flow
{% endblock %}

PROJECT_DIR = os.path.normpath(os.path.join(os.path.dirname(__file__), {{ project_dir | py }}))


{% block flow %}
@flow(name={{ name | py }}, retries={{ retries | py }}, log_prints=True)
def cartage_run() -> None:
    env = os.environ.get({{ cartage_env_var | py }}, {{ env | py }})
    command = [
        *shlex.split({{ command | py }}),
        "--project-dir", PROJECT_DIR,
        "run", {{ pipeline_path | py }},
        "--env", env,
    ]
    print(shlex.join(command))
    subprocess.run(command, check=True)
{% endblock %}


{% block serve %}
if __name__ == "__main__":
    cartage_run.serve(
        name={{ name | py }},
        tags={{ tags | pyw(8) }},
{% if schedule %}
        cron={{ schedule | py }},
{% endif %}
    )
{% endblock %}
{% block extra %}
{% endblock %}
