{% block header %}
# Generated by cartage {{ cartage_version }} from {{ pipeline_path }}. Do not edit by hand:
# change the pipeline YAML, cartage.yaml or templates/dagster/dagster.py.j2, then run `cartage generate --target dagster`.
# The cartage project (including transforms/) must be deployed with this file; see PROJECT_DIR.
{% endblock %}
{% block imports %}
import os
import shlex
import subprocess

import dagster as dg
{% endblock %}

PROJECT_DIR = os.path.normpath(os.path.join(os.path.dirname(__file__), {{ project_dir | py }}))


{% block op %}
@dg.op(name={{ (name ~ "_cartage_run") | py }})
def cartage_run(context: dg.OpExecutionContext) -> None:
    env = os.environ.get({{ cartage_env_var | py }}, {{ env | py }})
    command = [*shlex.split({{ command | py }}), '--project-dir', PROJECT_DIR, 'run', {{ pipeline_path | py }}, '--env', env]
    context.log.info(shlex.join(command))
    subprocess.run(command, check=True)
{% endblock %}


@dg.job(name={{ name | py }}, tags={{ tags | py }})
def job():
    cartage_run()


{% block definitions %}
defs = dg.Definitions(
    jobs=[job],
{% if schedule %}
    schedules=[dg.ScheduleDefinition(job=job, cron_schedule={{ schedule | py }}, execution_timezone={{ timezone | py }})],
{% endif %}
)
{% endblock %}
{% block extra %}
{% endblock %}
